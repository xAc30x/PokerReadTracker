{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "table-read-mobile-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "table-read-mobile-api",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEFAULT_OWNER_KEY": "primary-owner",
    "ALLOWED_ORIGIN": "https://table-read-poker-tracker.xac30x.chatgpt.site"
  }
}
